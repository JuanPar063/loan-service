# loan-service/.env.example
# Copia a .env y completa valores. NO subas .env al repo.

# ---------- APP / ENV ----------
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# ---------- DATABASE ----------
DATABASE_HOST=postgres-loan-service
DATABASE_PORT=5432
DATABASE_USER=admin
DATABASE_PASSWORD=changeme
DATABASE_NAME=loans-service
DATABASE_SCHEMA=public

# ---------- SERVICIOS EXTERNOS ----------
USER_SERVICE_URL=http://user-service:3000
# Circuit breaker hacia user-service
PROFILE_TIMEOUT_MS=5000
PROFILE_RESET_MS=10000

# ---------- AUTH ----------
# Mismo valor que el resto de microservicios. Obligatorio en producción.
JWT_SECRET=
# JWT_EXPIRATION=24h

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3004,http://localhost:3005

# ---------- RATE LIMITING ----------
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ---------- REGLAS DE NEGOCIO ----------
# Capacidad máxima de endeudamiento = múltiplo del ingreso mensual.
LOAN_MAX_INCOME_MULTIPLIER=12
